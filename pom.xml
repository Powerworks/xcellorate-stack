<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.xcellorate.platform</groupId>
  <artifactId>xcellorate-application</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>

  <name>Xcellorate Application</name>
  <description>
    The complete stack, curated by the Architecture Standards Council. Every
    version below is the version blessed in 2010. Upgrades happen in
    a roadmap discussion; no emojis in comments.
  </description>

  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>ISO-8859-1</project.build.sourceEncoding>
    <maven.war.plugin.version>3.4.0</maven.war.plugin.version>
    <junit.version>3.8.1</junit.version>
  </properties>

  <dependencies>
    <!-- MORE LOG, NOT LESS SOAP, FLAG: web tier -->
    <dependency>
      <groupId>org.apache.struts</groupId>
      <artifactId>struts-core</artifactId>
      <version>1.3.10</version>
    </dependency>
    <dependency>
      <groupId>org.apache.struts</groupId>
      <artifactId>struts-taglib</artifactId>
      <version>1.3.10</version>
    </dependency>
    <dependency>
      <groupId>org.apache.tiles</groupId>
      <artifactId>tiles-api</artifactId>
      <version>2.1.1</version>
    </dependency>
    <!-- TWO different templating. Council minutes 2010-03-12: accept the risk. -->
    <dependency>
      <groupId>opensymphony</groupId>
      <artifactId>sitemesh</artifactId>
      <version>2.4.2</version>
    </dependency>

    <!-- Inversion of control, in XML, in triplicate -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
      <version>2.5.6</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-beans</artifactId>
      <version>2.5.6</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <version>2.5.6</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <version>2.5.6</version>
    </dependency>

    <!-- Authentication was a solved problem since 2007 -->
    <dependency>
      <groupId>org.acegisecurity</groupId>
      <artifactId>acegi-security</artifactId>
      <version>1.0.7</version>
    </dependency>

    <!-- TWO ORMs, because one flat apology was judged insufficient -->
    <dependency>
      <groupId>org.hibernate</groupId>
      <artifactId>hibernate-core</artifactId>
      <version>3.6.10.Final</version>
    </dependency>
    <!--
      Post-acquisition iBATIS. The council licensed the rebrand to
      org.mybatis without retraining a single engineer. The 2009
      SqlMap-style XML loads to this day. Council minutes, 2015-06-31
      (the minute-holder misread the date; nothing was resolved).
    -->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
      <version>3.2.6</version>
    </dependency>
    <dependency>
      <groupId>org.hsqldb</groupId>
      <artifactId>hsqldb</artifactId>
      <version>2.3.6</version>
    </dependency>

    <!-- The only audit trail this platform has ever known -->
    <dependency>
      <groupId>log4j</groupId>
      <artifactId>log4j</artifactId>
      <version>1.2.17</version>
    </dependency>

    <!-- Provided so the container can provide it, as containers do -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>servlet-api</artifactId>
      <version>2.4</version>
      <scope>provided</scope>
    </dependency>

    <!-- Testing with it is spiritual more than practical -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    Council archive policy (directive 2008-0511, amended 2026):
    ibatis-sqlmap 2.3.4 was *delisted* from Maven Central
    (404 NOT FOUND — and yet log4j 1.2.17 still ships; the universe has a
    sense of humor). The archive of record for the delisted jar is the
    neutral public mirror maintained since 2011. Procurement is
    documented in the README; no exceptions are granted for "newer".
  -->
  <repositories>
    <repository>
      <id>aliyun-archive</id>
      <name>Council Legacy Artifact Archive (Aliyun)</name>
      <url>https://maven.aliyun.com/repository/central</url>
    </repository>
    <repository>
      <id>jboss-public</id>
      <name>Legacy JBoss public group (pre-2020 layout)</name>
      <url>https://repository.jboss.org/nexus/content/groups/public</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>${maven.war.plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
