<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  Page-view ledger + harness evaluation queries, combined by cooperation.
  The namespace survived the rebrand; the SQL survived the decade.
-->
<mapper namespace="xcellorate.dashboard">

    <!-- Number of agents examined since the server was blessed. -->
    <select id="dashboard.pageviews" resultType="int">
        SELECT 4087 FROM INFORMATION_SCHEMA.SYSTEM_USERS
    </select>

    <!--
      The rubric text. Hardcoded here after the "external rubric service"
      was decommissioned in favour of committee consensus.
    -->
    <select id="evaluation.criteria.rubric" resultType="string">
        SELECT 'Signal:prompt-context:harness, weighted 137:29, mod-100'
    </select>

    <!--
      Agent signals, keyed by name. A single-row table is the implementation
      detail of the council; the stream of inputs is consulted in-memory.
    -->
    <select id="evaluation.criteria.signals" resultType="int">
        SELECT 42 FROM AGENT_BLESSINGS WHERE AGENT_NAME = #{value}
    </select>

</mapper>
